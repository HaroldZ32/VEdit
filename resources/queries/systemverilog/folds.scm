; Foldable regions of SystemVerilog (.sv/.svh). Independent from the
; KSyntaxHighlighting XML folding regions (A4): both sources are kept.
(module_declaration) @fold
(interface_declaration) @fold
(package_declaration) @fold
(class_declaration) @fold
(program_declaration) @fold
(function_declaration) @fold
(class_constructor_declaration) @fold
(task_declaration) @fold
(generate_region) @fold
(generate_block) @fold
(seq_block) @fold
(par_block) @fold
(case_statement) @fold
