<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<!--
  VEdit Scala syntax definition (authored for VEdit; NOT a copy of KDE's scala.xml).
  Semantic source: the Scala 2.13 and Scala 3 language references (keywords,
  soft keywords, standard types). KDE's scala.xml (KF6 6.24, LGPL) was consulted
  only to cross-check the keyword inventory, in the same way the other VEdit
  definitions were cross-checked; no text, list or regex was copied, and its
  sha256 is registered in THIRD_PARTY_NOTICES.md §9.1.2.
  SPDX-License-Identifier: LGPL-2.1-or-later
  Extensions: `*.scala` and `*.sbt` — an sbt build definition is Scala
  (`build.sbt` is compiled Scala DSL), so it shares the definition.
  Effective definition (AC-7.8 honesty boundary, AGENT.md §9): this file is the
  private data file installed under <AppDir>/usr/share/org.kde.syntax-highlighting/
  syntax/. In a developer/container runtime the editor repository also sees
  KDE's own "Scala" definition and THAT one can win; this file must not be
  claimed as the renderer without evidence. The measured answer is recorded in
  evidence/batch-20261110b/scala-syntax/01-syntax.log.
  Folding: `{` / `}` open and close one brace region. Unlike a keyword-anchored
  region this stays balanced per line and survives single-statement bodies; it
  is the same construct KDE's own definition folds (feature reference only).
  Strings/comments are their own contexts, so a brace inside them is not
  counted.
  The file name deliberately differs from KDE's `scala.xml`.
-->
<language name="Scala" version="1" kateversion="5.0" section="Sources"
          extensions="*.scala;*.sbt" mimetype="text/x-scala"
          author="VEdit" license="LGPL-2.1-or-later">
  <highlighting>
    <list name="keywords">
      <item>abstract</item><item>case</item><item>catch</item><item>class</item>
      <item>def</item><item>do</item><item>else</item><item>extends</item>
      <item>false</item><item>final</item><item>finally</item><item>for</item>
      <item>forSome</item><item>if</item><item>implicit</item><item>import</item>
      <item>lazy</item><item>match</item><item>new</item><item>null</item>
      <item>object</item><item>override</item><item>package</item>
      <item>private</item><item>protected</item><item>return</item>
      <item>sealed</item><item>super</item><item>this</item><item>throw</item>
      <item>trait</item><item>true</item><item>try</item><item>type</item>
      <item>val</item><item>var</item><item>while</item><item>with</item>
      <item>yield</item>
    </list>
    <!-- Scala 3 soft keywords. They are ordinary identifiers in Scala 2 code
         (`val end = 1`), so they are coloured as keywords by convention only;
         this is a highlighting choice, not a parse claim. -->
    <list name="softKeywords">
      <item>as</item><item>derives</item><item>end</item><item>enum</item>
      <item>export</item><item>extension</item><item>given</item>
      <item>infix</item><item>inline</item><item>opaque</item><item>open</item>
      <item>then</item><item>transparent</item><item>using</item>
    </list>
    <list name="dataTypes">
      <item>Any</item><item>AnyRef</item><item>AnyVal</item><item>Boolean</item>
      <item>Byte</item><item>Char</item><item>Double</item><item>Float</item>
      <item>Int</item><item>Long</item><item>Nothing</item><item>Null</item>
      <item>Short</item><item>String</item><item>Unit</item>
      <item>Array</item><item>Seq</item><item>IndexedSeq</item><item>Vector</item>
      <item>List</item><item>Set</item><item>Map</item><item>Option</item>
      <item>Some</item><item>None</item><item>Either</item><item>Left</item>
      <item>Right</item><item>Try</item><item>Success</item><item>Failure</item>
      <item>Future</item><item>Promise</item><item>Iterable</item>
      <item>Iterator</item><item>Ordering</item><item>BigInt</item>
      <item>BigDecimal</item>
    </list>
    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <!-- Comments first: a quote or an operator inside a comment is data.
             Scala block comments nest, which a KSyntaxHighlighting context
             cannot count; the inner `/*` stays part of this context (KDE's own
             definition behaves the same), so only the depth-0 close pops. -->
        <RegExpr attribute="Comment" context="#stay" String="//.*$"/>
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="*"
                      beginRegion="Comment"/>
        <!-- Triple-quoted string BEFORE the single-quote rules: `"""` must not
             open a one-line string. -->
        <StringDetect attribute="String" context="StringTriple" String="&quot;&quot;&quot;"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <!-- Character literal before the type/symbol use of the apostrophe.
             `'a'` is a char; `'sym` (Scala 2 symbol) and `'[A]` (Scala 3 type
             quote) are left to the default text, which is honest: neither is a
             string literal. -->
        <RegExpr attribute="String" context="#stay" String="'(\\.|[^'\\])'"/>
        <RegExpr attribute="Annotation" context="#stay" String="@[A-Za-z_][A-Za-z0-9_]*"/>
        <!-- Numbers: hex/binary with the L suffix, then floating point, then
             decimal. Underscore separators are accepted since Scala 2.13. -->
        <RegExpr attribute="Number" context="#stay" String="\b0[xX][0-9A-Fa-f_]+L?"/>
        <RegExpr attribute="Number" context="#stay" String="\b0[bB][01_]+L?"/>
        <RegExpr attribute="Number" context="#stay" String="\b\d[\d_]*\.\d[\d_]*([eE][+-]?\d+)?[fFdD]?"/>
        <RegExpr attribute="Number" context="#stay" String="\b\d[\d_]*([eE][+-]?\d+)?[LlFfDd]?\b"/>
        <!-- Brace folding (see the header comment). -->
        <DetectChar attribute="Operator" context="#stay" char="{" beginRegion="Brace"/>
        <DetectChar attribute="Operator" context="#stay" char="}" endRegion="Brace"/>
        <keyword attribute="Keyword" context="#stay" String="softKeywords"/>
        <keyword attribute="Data Type" context="#stay" String="dataTypes"/>
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <!-- Operators last: they include the characters that start a comment,
             a string or a char literal, all of which have already matched. -->
        <RegExpr attribute="Operator" context="#stay" String="[=!&lt;&gt;+\-*/%&amp;|^~?:]+"/>
      </context>
      <context name="BlockComment" attribute="Comment" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="#pop" char="*" char1="/"
                      endRegion="Comment"/>
      </context>
      <context name="String" attribute="String" lineEndContext="#pop">
        <!-- Escape sequence first, so `\"` does not close the string. -->
        <Detect2Chars attribute="String" context="#stay" char="\" char1="&quot;"/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
      <context name="StringTriple" attribute="String" lineEndContext="#stay">
        <StringDetect attribute="String" context="#pop" String="&quot;&quot;&quot;"/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword" defStyleNum="dsKeyword"/>
      <itemData name="Data Type" defStyleNum="dsDataType"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="Number" defStyleNum="dsDecVal"/>
      <itemData name="Operator" defStyleNum="dsOperator"/>
      <itemData name="Annotation" defStyleNum="dsAttribute"/>
    </itemDatas>
    <!-- Scala identifiers are case-sensitive (`object` is not `Object`). -->
    <keywords casesensitive="1"/>
  </highlighting>
</language>
