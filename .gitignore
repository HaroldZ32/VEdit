# --- MPD harness state -------------------------------------------------------
# Tool state (cellwork/team/verify/memory). The memory store is its own VCS repo,
# so keeping it out of the product repo avoids a nested repository.
.mpd/

# Code analysis index written by codegraph tooling (tool state, not source).
.codegraph/

# --- Rust build output -------------------------------------------------------
target/

# --- Build / packaging artifacts --------------------------------------------
build/artifacts/
*.AppImage
*.AppImage.zsync
# global product patterns: archives and the self-extracting single file
*.tar.gz
*.tgz
*.run

# --- slang build spike: fetched inputs and built output ----------------------
build/slang/cache/
build/slang/out/
build/slang/tmp/
build/slang/slang-12.1/

# --- editor / OS noise -------------------------------------------------------
*.swp
*.swo
*~
.DS_Store

# --- reproducible local build trees / extracted artefacts ---------------------
# AppImage staging trees and the extracted image root: both are regenerated by
# packaging/runtime/assemble-appdir.sh and the pinned image, never hand-edited.
packaging/runtime/out/
.f2-work/
# Probe and evidence harness build output (cargo/cmake targets).
evidence/fim/real-endpoint/harness/target/
probes/*/build/
# Abandoned GTK spike build tree (1.4G, kept on disk, never versioned).
build/gui-spike/
# CMake/Ninja output directories that appear inside lane sources.
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
