# --- MPD harness state -------------------------------------------------------
# Tool state (cellwork/team/verify/memory). The memory store is its own VCS repo,
# so keeping it out of the product repo avoids a nested repository.
.mpd/

# Code analysis index written by codegraph tooling (tool state, not source).
.codegraph/

# --- Rust build output -------------------------------------------------------
target/

# --- Build / packaging artifacts --------------------------------------------
build/artifacts/
*.AppImage
*.AppImage.zsync
# global product patterns: archives and the self-extracting single file
*.tar.gz
*.tgz
*.run

# --- slang build spike: fetched inputs and built output ----------------------
build/slang/cache/
build/slang/out/
build/slang/tmp/
build/slang/slang-12.1/

# --- editor / OS noise -------------------------------------------------------
*.swp
*.swo
*~
.DS_Store

# --- reproducible local build trees / extracted artefacts ---------------------
# AppImage staging trees and the extracted image root: both are regenerated by
# packaging/runtime/assemble-appdir.sh and the pinned image, never hand-edited.
packaging/runtime/out/
.f2-work/
# Probe and evidence harness build output (cargo/cmake targets).
evidence/fim/real-endpoint/harness/target/
probes/*/build/
# Abandoned GTK spike build tree (1.4G, kept on disk, never versioned).
build/gui-spike/
# CentOS 7 on-machine verification (T83): build/centos7-verify/build-tarball.sh
# assembles these on every run. The scripts (build-tarball.sh,
# verify-centos7.sh), STEPS.md and the samples/verilog-demo fixture are inputs
# and stay tracked.
build/centos7-verify/AppDir/
build/centos7-verify/stage/
build/centos7-verify/dist/
# CMake/Ninja output directories that appear inside lane sources.
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake

# --- generated test data ------------------------------------------------------
# The file-tree lane's 10,000-file laziness fixture (10,006 zero-byte files). It
# is generated data: reproduce it with
#   bash src/workspace/filetree/tools/generate-testdata.sh
# (the lane's own entries regenerate it too). Never commit it.
filetree-testdata/

# Compiled probe executables under evidence/ are build artifacts, not evidence:
# their sources (*.cpp, *.sh) stay tracked, only the ELF binaries are ignored.
# The pattern is anchored to probe directories on purpose: a bare
# `evidence/**/*-probe` also swallowed DIRECTORIES named ...-probe.
evidence/**/probes/*-probe
evidence/**/probe/*-probe
# Same for the ksh-env probe binaries a previous batch left in scratch AppDirs.
evidence/**/vedit-*-probe
