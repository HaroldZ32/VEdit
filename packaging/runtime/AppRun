#!/bin/sh
# AppRun for the VEdit Qt6/KF6 private runtime — F2 form (T64 / T61).
#
# Two jobs:
#   1. start the binary through the loader that ships inside the package, with
#      the package's lib/ as the only library path (C2);
#   2. isolate syntax-definition lookup: XDG_DATA_DIRS *and* XDG_DATA_HOME point
#      into the AppDir, so a host with KDE installed cannot leak its definitions
#      into the product (F2 conditions C3/C4). A runtime guard (C7) then checks
#      that every loaded definition is on the whitelist and fails closed.
#
# Usage: AppRun [--selfcheck] [--] [args]
set -u

# A host shell may initialize an unset PATH locally. Only save the value when
# it was exported by the caller, and preserve an explicitly empty value.
if /usr/bin/printenv PATH >/dev/null; then
    export VEDIT_HOST_PATH="$PATH"
else
    unset VEDIT_HOST_PATH
fi
# Use system utilities for launcher setup even when the caller's PATH is empty.
export PATH=/usr/bin:/bin
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
APPDIR="$HERE"
export APPDIR

# --- crash report: bounded AppImage hashing (batch-20261110d) ----------------
# The crash reporter records the AppImage sha256 in install(), i.e. on the
# STARTUP path, when the caller did not supply the hash. Its old hardcoded cap
# (160 MiB) never fired for a 95-139 MB AppImage, so the whole file was hashed
# before the window existed. The budget is part of the launch contract and is
# exported here; the reporter reads this SAME variable (default 4 MiB, ≈5-20 ms;
# a larger image gets a clearly-marked PREFIX hash instead of a full one). Set
# VEDIT_APPIMAGE_SHA256_BUDGET_MIB=0 to skip hashing entirely at launch.
if [ -n "${APPIMAGE:-}" ] && [ -z "${VEDIT_APPIMAGE_SHA256_BUDGET_MIB:-}" ]; then
    export VEDIT_APPIMAGE_SHA256_BUDGET_MIB=4
fi

# --- bundled toolchain: the launch contract names the tools ------------------
# AppRun is the launch contract, and it enters the product through the private
# loader, so the process's executable directory is the AppDir ROOT rather than
# bin/. Naming the bundled tools here makes the packaged layout unambiguous.
# This is a stopgap, not the only path: the product-side resolver (Qt and the
# Rust hierarchy service) also probes `<AppDir>/bin` itself, so the package
# still works when this script is bypassed. Every tool below is exported only
# when the caller did not set it (an explicit value always wins) AND the
# packaged file exists and is executable. This guard is required, not cosmetic:
# the Qt module-tree lane reads VEDIT_SLANG first (moduleTreeSlangBinary()), so
# an unconditional or dead value would mask the diagnostics-resolved toolchain
# and the documented environment override (docs/USER_GUIDE.md troubleshooting).
if [ -z "${VEDIT_SLANG:-}" ] && [ -x "$APPDIR/bin/slang" ]; then
    export VEDIT_SLANG="$APPDIR/bin/slang"
fi
if [ -z "${VEDIT_VERIBLE_LS:-}" ] && [ -x "$APPDIR/bin/verible-verilog-ls" ]; then
    export VEDIT_VERIBLE_LS="$APPDIR/bin/verible-verilog-ls"
fi
if [ -z "${VEDIT_VERIBLE_LINT:-}" ] && [ -x "$APPDIR/bin/verible-verilog-lint" ]; then
    export VEDIT_VERIBLE_LINT="$APPDIR/bin/verible-verilog-lint"
fi
if [ -z "${VEDIT_VERIBLE_FORMAT:-}" ] && [ -x "$APPDIR/bin/verible-verilog-format" ]; then
    export VEDIT_VERIBLE_FORMAT="$APPDIR/bin/verible-verilog-format"
fi
# Translations: AppRun enters through the bundled loader, so the product's
# applicationDirPath() is the AppDir root while the .qm are installed under
# bin/translations. The product probes that layout itself (src/app/i18n.cpp);
# naming it here makes the packaged source explicit and keeps the diagnostic
# pointing at the directory that was actually checked. Guarded like the tools:
# an explicit value wins and a missing directory is never exported.
if [ -z "${VEDIT_TRANSLATIONS_DIR:-}" ] && [ -d "$APPDIR/bin/translations" ]; then
    export VEDIT_TRANSLATIONS_DIR="$APPDIR/bin/translations"
fi

# --- private plugin search paths (package only) ------------------------------
# NB: LD_LIBRARY_PATH is exported only right before exec (see below). Exporting it
# here would make host utilities (cat/sed/grep/id/mkdir) load OUR glibc through the
# HOST loader and fail on a CentOS 7 host, silently breaking the guard below.
export QT_PLUGIN_PATH="$APPDIR/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$APPDIR/plugins/platforms"
export QML2_IMPORT_PATH="$APPDIR/qml"

# --- F2: XDG narrowed to the AppDir ONLY (C3 + C4) ---------------------------
# Never append /usr/share or keep $HOME/.local/share: both were measured to leak
# host/user definitions (FORM-DECISION §1: f2-xdgdirs-only -> 2 defs, f2-override
# -> 402 defs). Setting only one of the two variables is NOT enough.
export XDG_DATA_DIRS="$APPDIR/usr/share"
export XDG_DATA_HOME="$APPDIR/usr/share"
export VEDIT_SYNTAX_DIR="$APPDIR/usr/share/org.kde.syntax-highlighting"

# --- fonts (no host fontconfig data) ----------------------------------------
export FONTCONFIG_FILE="$APPDIR/etc/fonts/fonts.conf"
export FONTCONFIG_PATH="$APPDIR/etc/fonts"
: "${XDG_CACHE_HOME:=/tmp/vedit-cache-$(id -u)}"
export XDG_CACHE_HOME
mkdir -p "$XDG_CACHE_HOME" 2>/dev/null || true

# --- locale: Qt needs a UTF-8 locale ----------------------------------------
# CentOS 7's default is C / ANSI_X3.4-1968. The host locale archive is glibc
# 2.17 data; the PACKAGED glibc cannot load it (setlocale NULL), so the package
# ships /usr/lib/locale/C.utf8 and LOCPATH is set for the product. The fallback
# is only announced when it is used; if it cannot be used, the original locale
# is kept and that is announced once (never silent).
CURRENT_LOCALE_DESC="${LC_ALL:-${LC_CTYPE:-${LANG:-unset}}}"
CURRENT_CHARMAP=$(locale charmap 2>/dev/null || true)
BUNDLED_UTF8_LOCALE="$APPDIR/usr/lib/locale/C.utf8"
CHOSEN_LOCALE=""
use_bundled_utf8_locale() {
    [ -d "$BUNDLED_UTF8_LOCALE" ] || return 1
    CHOSEN_LOCALE=C.UTF-8
    return 0
}
bundled_charmap_ok() {
    [ -x "$APPDIR/ld-linux-x86-64.so.2" ] || return 1
    [ -x /usr/bin/locale ] || return 1
    LC_ALL="$1" LANG="$1" LOCPATH="$APPDIR/usr/lib/locale" \
        "$APPDIR/ld-linux-x86-64.so.2" --library-path "$APPDIR/lib" \
        /usr/bin/locale charmap 2>/dev/null | grep -qi '^utf-8$'
}
NEED_LOCALE_FALLBACK=0
if ! printf '%s' "${CURRENT_CHARMAP:-unknown}" | grep -qi '^utf-8$'; then
    NEED_LOCALE_FALLBACK=1
elif ! bundled_charmap_ok "${LC_ALL:-${LC_CTYPE:-${LANG:-C}}}"; then
    # e.g. LC_ALL=en_US.utf8 is UTF-8 for the host glibc but not for the packaged
    # one (only C.utf8 is shipped); fall back to the packaged locale.
    NEED_LOCALE_FALLBACK=1
fi
if [ "$NEED_LOCALE_FALLBACK" -eq 1 ]; then
    if use_bundled_utf8_locale; then
        printf '%s\n' "AppRun: locale '${CURRENT_LOCALE_DESC}' (${CURRENT_CHARMAP:-unknown}) -> '${CHOSEN_LOCALE}' (bundled UTF-8 fallback)" >&2
    else
        printf '%s\n' "AppRun: locale '${CURRENT_LOCALE_DESC}' is not UTF-8 and no packaged UTF-8 locale is available; keeping it" >&2
    fi
fi

# --- known noise only: never mute qt.qpa.* (real display/DBus errors) -------
VEDIT_NOISE_RULES="qt.multimedia.symbolsresolver=false;kf.sonnet.core=false"
if [ -n "${QT_LOGGING_RULES:-}" ]; then
    export QT_LOGGING_RULES="${QT_LOGGING_RULES};${VEDIT_NOISE_RULES}"
else
    export QT_LOGGING_RULES="$VEDIT_NOISE_RULES"
fi

# --- KF6 config location that cannot be written (diagnosis 2026-11-16) ------
# KF6 KConfig answers a non-writable config file with a MODAL kdialog
# ("Configuration file ... not writable") and the product WAITS for it: the
# KTextEditor singleton (KateGlobalConfig) is built inside QApplication's
# constructor by veditSyntaxProductStartup(), so EVERY launch -- including
# --version / --help / --selfcheck -- blocks until that dialog is answered, and
# a headless (offscreen) launch can never answer it. KDE_HOME_READONLY degrades
# the failure to a warning instead of the dialog. Exported only when the
# location really is unusable, so a normal desktop is untouched.
#
# "Unusable" means KF6 could not create/write its files there, NOT `-w` on the
# config directory alone: a fresh account has no .config yet and KConfig
# CREATES it, so a missing directory whose nearest existing parent is writable
# is usable. (The first form of this guard exported KDE_HOME_READONLY=1 for
# every brand-new HOME, disabling config writes on a writable desktop; fixed
# in batch-20261115/fix2.)
#
# A path that EXISTS but is not a directory is UNUSABLE, not "not this guard's
# failure mode": KF6 wants `<config>/vd-apprc`, gets ENOTDIR, and answers with
# the same MODAL kdialog -- the product hangs exactly as it does on a read-only
# HOME. This covers a regular file, a device/FIFO, a symlink to one, and a
# DANGLING symlink: `-e` follows links, so `-L` is the fallback. Trailing
# slashes are stripped first, because `<file>/` makes both tests false and the
# guard would slide into the "missing directory" branch. (fix2 answered usable
# for all of these -> pack/fix2-review Finding 1; fixed in fix3.)
VEDIT_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}"
vd_config_usable() {
    # `/` keeps its slash: the loop would otherwise leave an empty path.
    vd_path=$VEDIT_CONFIG_HOME
    while [ -n "${vd_path%/}" ] && [ "${vd_path%/}" != "$vd_path" ]; do
        vd_path=${vd_path%/}
    done
    if [ -d "$vd_path" ]; then
        [ -w "$vd_path" ] || return 1
        for vd_name in vd-apprc vedit-apprc; do
            if [ -e "$vd_path/$vd_name" ] && [ ! -w "$vd_path/$vd_name" ]; then
                return 1
            fi
        done
        return 0
    fi
    if [ -e "$vd_path" ] || [ -L "$vd_path" ]; then
        return 1
    fi
    # Missing directory: KF6 may create it, so check the nearest existing
    # parent DIRECTORY instead. An EXISTING non-directory ancestor is a
    # blocker, not a step to skip: nothing below it can ever be created, and
    # the product hangs on the same kdialog (measured on the fix2 image:
    # XDG_CONFIG_HOME=<regular file>/.config -> --version rc=124).
    vd_probe=$vd_path
    while [ -n "$vd_probe" ] && [ ! -d "$vd_probe" ]; do
        if [ -e "$vd_probe" ] || [ -L "$vd_probe" ]; then
            return 1
        fi
        case $vd_probe in
            */*) vd_probe=${vd_probe%/*}; [ -n "$vd_probe" ] || vd_probe=/ ;;
            *) vd_probe=. ;;
        esac
    done
    [ -n "$vd_probe" ] && [ -w "$vd_probe" ]
}
if ! vd_config_usable; then
    export KDE_HOME_READONLY=1
fi

# --- C7 runtime guard: fail closed if the whitelist is not the visible set ---
# Canonical form of a comma-separated definition-name list. The whitelist is
# written by assemble-appdir.sh with Python's sorted() (code-point order), while
# `sort` uses the CALLER's collation: under zh_CN.UTF-8 / en_US.UTF-8 it orders
# `Verilog` before `VHDL`, so a CORRECT package failed closed with exit 2 on
# every non-C locale before the app started (A3 blocker 1). Both sides are
# normalised under LC_ALL=C — the one collation every host `sort` implements —
# because the guard compares SETS, not the byte order the producer happened to
# use. Do not remove this: the packaged launcher must not depend on the desktop
# locale.
canonical_names() {
    printf '%s\n' "$1" | tr ',' '\n' | sed '/^$/d' | LC_ALL=C sort | paste -sd, -
}
ksh_guard() {
    [ -x "$APPDIR/bin/vedit-ksh-env-probe" ] || return 0
    [ -s "$APPDIR/usr/share/vedit/ksh-whitelist.txt" ] || return 0
    wl=$(canonical_names "$(cat "$APPDIR/usr/share/vedit/ksh-whitelist.txt")")
    # batch-20261110d: this probe used to run UNBOUNDED from `out=$(...)`, with
    # the desktop environment and stdin inherited. `--editor-repo` makes the
    # probe initialise KTextEditor's singleton, whose KF6/D-Bus work blocks: the
    # same command did not return within 25 s under `env -i` and within 90 s
    # with the host KDE data visible — every launch waited on it ("30-second
    # startup"). Three rules:
    #   1. the probe is not asked for the KTextEditor repository: the guard's
    #      comparison consumes `KSH-ENV def name=` lines, which the PLAIN
    #      repository emits (measured 51 ms instead of "never returns"). The
    #      editor view stays observable through the F2 experiment script, which
    #      invokes the probe directly;
    #   2. stdin is /dev/null and the work is capped at 5 s, so a future probe
    #      that blocks cannot hold the launcher;
    #   3. a timeout fails OPEN with a NAMED line. The guard exists to catch a
    #      WRONG visible set; no answer is not a wrong answer, and a silent skip
    #      is not allowed either.
    if ! command -v timeout >/dev/null 2>&1; then
        echo "KSH-GUARD SKIP: timeout(1) is not available; visible definitions not verified" >&2
        return 0
    fi
    out=$(QT_QPA_PLATFORM=offscreen LOCPATH="$APPDIR/usr/lib/locale" \
            timeout 5 "$APPDIR/ld-linux-x86-64.so.2" --library-path "$APPDIR/lib" \
            "$APPDIR/bin/vedit-ksh-env-probe" --list < /dev/null 2>&1)
    rc=$?
    if [ "$rc" -eq 124 ]; then
        echo "KSH-GUARD SKIP: probe exceeded 5s; visible definitions not verified (fail-open)" >&2
        return 0
    fi
    # The trailing `file="..."` (R2) is deliberately ignored here: the guard
    # compares the visible NAME SET; the F2 script asserts the winning paths.
    seen=$(printf '%s\n' "$out" | sed -n 's/^KSH-ENV def name="\([^"]*\)".*$/\1/p' \
             | LC_ALL=C sort | paste -sd, -)
    if [ "${VEDIT_DEBUG:-0}" = "1" ]; then
        printf '%s\n' "$out" | grep '^KSH-ENV defs=' >&2
    fi
    if [ "$rc" -ne 0 ] || [ "$seen" != "$wl" ]; then
        echo "KSH-GUARD FAIL: visible definitions [$seen] != whitelist [$wl]" >&2
        exit 2
    fi
    if [ "${VEDIT_DEBUG:-0}" = "1" ]; then
        echo "KSH-GUARD PASS whitelist=$wl" >&2
    fi
}
ksh_guard

# now that no host utility will run any more, hand the loader search path to the app
# (the fallback locale, LOCPATH and LD_LIBRARY_PATH are passed to the PRODUCT via
# `env`, never exported into the host shell: glibc 2.17 has no C.UTF-8 and bash
# would warn on every command; exporting LD_LIBRARY_PATH would also make the
# host /usr/bin/env load the package libc.  KEEP the line below as a comment
# marker for the old approach.)

BIN="$APPDIR/bin/vd-app"
[ -x "$BIN" ] || { echo "AppRun: product binary missing: $BIN" >&2; exit 1; }

run_app() {
    export PATH="$APPDIR/bin${VEDIT_HOST_PATH:+:$VEDIT_HOST_PATH}"
    LIBPATH="$APPDIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    if [ -n "$CHOSEN_LOCALE" ]; then
        exec /usr/bin/env LANG="$CHOSEN_LOCALE" LC_ALL="$CHOSEN_LOCALE" \
            LOCPATH="$APPDIR/usr/lib/locale" LD_LIBRARY_PATH="$LIBPATH" \
            "$APPDIR/ld-linux-x86-64.so.2" --library-path "$APPDIR/lib" "$BIN" "$@"
    fi
    exec /usr/bin/env LOCPATH="$APPDIR/usr/lib/locale" LD_LIBRARY_PATH="$LIBPATH" \
        "$APPDIR/ld-linux-x86-64.so.2" --library-path "$APPDIR/lib" "$BIN" "$@"
}

case "${1:-}" in
  --selfcheck)
    shift
    run_app --selfcheck "$@"
    ;;
  *)
    if [ "${VEDIT_DEBUG:-0}" != "1" ]; then
        export VEDIT_QUIET=1
    fi
    run_app "$@"
    ;;
esac
