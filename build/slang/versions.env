# Pinned build inputs for the CentOS 7 (glibc 2.17) slang build.
# Every value here is an input of scripts/build-in-container.sh; the build fails
# loudly when a downloaded archive does not match its sha256.
# Build image for the slang build container. CentOS 7.9.2009 = the glibc 2.17
# deployment target. Override the ref (or its fallback registry) through the
# environment; both defaults keep the historical values.
SLANG_BUILD_IMAGE="${SLANG_BUILD_IMAGE:-docker.m.daocloud.io/library/centos:7}"
SLANG_BUILD_IMAGE_FALLBACK="${SLANG_BUILD_IMAGE_FALLBACK:-docker.io}"
SLANG_VERSION="12.1"
SLANG_TAG="v12.1"
SLANG_REPO="https://github.com/MikePopoloski/slang.git"
# refs/tags/v12.1 -> peeled commit (verified with `git ls-remote --tags`); the
# in-container script checks `git rev-parse HEAD` against this value.
SLANG_COMMIT="42710c788ce76cd08ce2080773e0b8286c428a05"
# slang v12.1 requires CMake >= 3.28; CentOS 7 ships 2.8 and EPEL 7 cmake3 is
# 3.17, so the official Kitware x86_64 binary is used (it runs on glibc 2.17).
CMAKE_VERSION="3.31.6"
CMAKE_URL="https://github.com/Kitware/CMake/releases/download/v3.31.6/cmake-3.31.6-linux-x86_64.tar.gz"
CMAKE_SHA256="5a1133ff103c71eb5120e2cc3de922733e7d8a26a98ae716397e8676adb367bf"
# CentOS 7.9.2009 vault mirror; the stock mirror list is dead, see
# .mpd/recon/build-recipe-centos7.md. Override only with another vault mirror.
CENTOS_VAULT_BASE="https://mirrors.tuna.tsinghua.edu.cn/centos-vault/7.9.2009"
# slang's code generators (scripts/syntax_gen.py) need Python >= 3.9
# (str.removesuffix); CentOS 7 ships 2.7.5 and its newest SCL Python is 3.8, so
# CPython is built from source INSIDE the build container (build-time only: the
# produced binary does not depend on it).
PYTHON_VERSION="3.12.8"
PYTHON_URL="https://www.python.org/ftp/python/3.12.8/Python-3.12.8.tgz"
PYTHON_SHA256="5978435c479a376648cb02854df3b892ace9ed7d32b1fead652712bee9d03a45"
