# Build environment for VEdit on CentOS 7.9.2009 (glibc 2.17) — the deployment
# target itself, so the produced ELF never needs a newer glibc.
#
# Reproducibility (AC-19): the base image is pinned by digest, every download is
# pinned by sha256 in scripts/versions.env and verified before use, and the
# full installed RPM set is snapshotted (scripts/docker/rpm-baseline.txt) and
# compared on every build by scripts/build-in-container.sh.
FROM docker.m.daocloud.io/library/centos@sha256:be65f488b7764ad3638f236b7b515b3678369a5124c47b8d32916d6487418ea4

ARG CENTOS_VAULT_BASE
ARG RUSTUP_URL
ARG RUSTUP_SHA256
ARG RUST_TOOLCHAIN
ARG GSV_URL
ARG GSV_SHA256
ARG MESON_WHEEL_URL
ARG MESON_WHEEL_SHA256
ARG NINJA_WHEEL_URL
ARG NINJA_WHEEL_SHA256

# The stock CentOS-*.repo files point at dead mirrors; use the vault snapshot
# (recipe: .mpd/recon/build-recipe-centos7.md). The repo file lives in the build
# context and is rendered with the pinned CENTOS_VAULT_BASE argument, so the
# image builds under BuildKit (no legacy-builder-only syntax).
COPY vault.repo.in /tmp/vault.repo.in
RUN rm -f /etc/yum.repos.d/CentOS-*.repo \
 && sed "s|@CENTOS_VAULT_BASE@|${CENTOS_VAULT_BASE}|g" /tmp/vault.repo.in > /etc/yum.repos.d/vault.repo \
 && rm -f /tmp/vault.repo.in \
 && cat /etc/yum.repos.d/vault.repo

# GTK3 + GtkSourceView build/runtime dependencies, an X server for the window
# smoke test, and the fonts a GTK application needs to lay out text.
RUN yum -y install \
      gcc gcc-c++ make pkgconfig git curl tar xz bzip2 which findutils file \
      glib2-devel gtk3-devel libxml2-devel gettext \
      gdk-pixbuf2 gdk-pixbuf2-devel \
      python3 \
      dejavu-sans-fonts dejavu-sans-mono-fonts fontconfig \
      xorg-x11-server-Xvfb xorg-x11-utils mesa-demos mesa-libGL \
 && yum clean all

# AC-16 (Chinese input) needs GTK input-method modules at runtime. The packaging
# lanes bundle them, so this step records which immodule packages the vault
# actually carries (and which .so files exist) instead of guessing later.
RUN mkdir -p /opt/vedit \
 && { echo "## gtk3 immodule packages in the CentOS 7.9.2009 vault:"; \
      for pkg in gtk3-immodule-xim gtk3-immodule-ibus ibus-gtk3; do \
        if yum -y install "$pkg" >/dev/null 2>&1; then echo "installed $pkg"; \
        else echo "not available: $pkg"; fi; \
      done; \
      echo "## immodule files:"; \
      ls -l /usr/lib64/gtk-3.0/3.0.0/immodules/ 2>&1 || true; \
    } | tee /opt/vedit/immodules.txt

# meson/ninja from sha256-pinned PyPI wheels (no pip, no unpinned index access).
RUN set -eux; \
    curl -fsSL -o /tmp/meson.whl "$MESON_WHEEL_URL"; \
    echo "$MESON_WHEEL_SHA256  /tmp/meson.whl" | sha256sum -c -; \
    curl -fsSL -o /tmp/ninja.whl "$NINJA_WHEEL_URL"; \
    echo "$NINJA_WHEEL_SHA256  /tmp/ninja.whl" | sha256sum -c -; \
    mkdir -p /opt/wheels/meson /opt/wheels/ninja; \
    python3 -m zipfile -e /tmp/meson.whl /opt/wheels/meson; \
    pysite=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])'); \
    mkdir -p "$pysite"; \
    cp -a /opt/wheels/meson/mesonbuild "$pysite/"; \
    { echo '#!/usr/bin/python3'; \
      echo 'import sys'; \
      echo 'from mesonbuild.mesonmain import main'; \
      echo 'if __name__ == "__main__":'; \
      echo '    sys.exit(main())'; \
    } > /usr/local/bin/meson; \
    chmod 755 /usr/local/bin/meson; \
    python3 -m zipfile -e /tmp/ninja.whl /opt/wheels/ninja; \
    cp /opt/wheels/ninja/ninja/data/bin/ninja /usr/local/bin/ninja; \
    chmod 755 /usr/local/bin/ninja; \
    meson --version; ninja --version

# Rust toolchain, installed inside the target distro so the ELF floor is
# CentOS 7's glibc. rustup-init and the toolchain version are pinned.
RUN set -eux; \
    curl -fsSL -o /tmp/rustup-init "$RUSTUP_URL"; \
    echo "$RUSTUP_SHA256  /tmp/rustup-init" | sha256sum -c -; \
    chmod 755 /tmp/rustup-init; \
    RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo /tmp/rustup-init \
      -y --no-modify-path --profile minimal --default-toolchain "$RUST_TOOLCHAIN"; \
    RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo /opt/cargo/bin/rustup component add \
      --toolchain "$RUST_TOOLCHAIN" rustfmt clippy; \
    chmod -R a+rX /opt/rust /opt/cargo; \
    RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo /opt/cargo/bin/rustc --version

# GtkSourceView 4.6.1 from the pinned upstream tarball (LGPL-2.1-or-later), into
# /opt/gsv4 so it never collides with a distribution gsv3.
RUN set -eux; \
    curl -fsSL -o /tmp/gtksourceview.tar.xz "$GSV_URL"; \
    echo "$GSV_SHA256  /tmp/gtksourceview.tar.xz" | sha256sum -c -; \
    mkdir -p /opt/src/gtksourceview; \
    tar -xJf /tmp/gtksourceview.tar.xz -C /opt/src/gtksourceview --strip-components=1; \
    cd /opt/src/gtksourceview; \
    meson setup build --prefix=/opt/gsv4 --libdir=lib64 \
      -Dgtk_doc=false -Dgir=false -Dvapi=false -Dinstall_tests=false -Dglade_catalog=false; \
    ninja -C build; \
    ninja -C build install; \
    rm -rf /opt/src/gtksourceview /tmp/gtksourceview.tar.xz

ENV PKG_CONFIG_PATH=/opt/gsv4/lib64/pkgconfig:/opt/gsv4/lib/pkgconfig \
    LD_LIBRARY_PATH=/opt/gsv4/lib64:/opt/gsv4/lib \
    RUSTUP_HOME=/opt/rust \
    RUSTUP_TOOLCHAIN=${RUST_TOOLCHAIN} \
    PATH=/opt/cargo/bin:/usr/local/bin:/usr/bin:/bin

# Record the exact installed package set inside the image (also committed as
# scripts/docker/rpm-baseline.txt and diffed on every build).
RUN { echo "## image facts"; cat /etc/centos-release; \
      echo "glibc: $(rpm -q glibc)"; \
      echo "gtk3: $(rpm -q gtk3)"; \
      echo "rust: $(/opt/cargo/bin/rustc --version)"; \
      echo "gsv4: $(PKG_CONFIG_PATH=/opt/gsv4/lib64/pkgconfig pkg-config --modversion gtksourceview-4)"; \
    } > /opt/vedit/build-image.txt \
 && rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /opt/vedit/rpm-snapshot.txt
