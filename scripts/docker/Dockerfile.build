# Build environments for VEdit — two STAGES in one file, every input pinned.
#
#   stage `qt6-build`  (declared FIRST): the modern build distro of the Qt6/KF6
#        C++ lane (M0 build base, task T10). Selected explicitly with
#        `docker build --target qt6-build -f scripts/docker/Dockerfile.build`.
#   stage `rust-build` (declared LAST): the historical CentOS 7.9.2009
#        (glibc 2.17) image that compiles the Rust/GTK product and is that
#        product's deployment target. A plain
#        `docker build -f scripts/docker/Dockerfile.build` builds THIS stage
#        (Docker builds the last stage by default), so scripts/build.sh,
#        scripts/gates.sh and CI keep their exact previous behaviour.
#
# Reproducibility: both stages pin their base image by digest; every download is
# pinned by sha256 (scripts/versions.env for the Rust/GTK lane;
# scripts/versions-qt.env + scripts/docker/qt6-locked-packages.txt for the Qt6
# lane) and verified before use; the installed package set is snapshotted.
#
# =============================================================================
# Stage: qt6-build
#
# Qt 6.10.2 / KF6 6.24.0 / KTextEditor 6.24.0 / KSyntaxHighlighting 6.24.0 /
# tree-sitter 0.25.9 on Ubuntu 26.04.1 LTS, pinned by digest + exact package
# versions + .deb sha256. This is deliberately a BUILD distro, not the
# deployment target: the deliverable carries its own loader + glibc + Qt6/KF6
# runtime (C2, task T11), so the binary may need symbols newer than CentOS 7's
# glibc 2.17. KF6 6.24 requires Qt >= 6.8 upstream, and the CentOS 7 vault has
# no Qt >= 6.5 at all -- building this lane on CentOS 7 is impossible, while the
# bundled runner makes the modern build distro irrelevant to the user's machine.
# The CentOS 7 kernel (3.10) is still satisfied: this glibc 2.43 is built with
# "Minimum supported kernel: 3.2.0" (see scripts/versions-qt.env).
#
# Both base-image ARGs must be declared BEFORE the first FROM: a FROM can only
# read global-scope build arguments, and the rust-build stage's base image is a
# build argument too (scripts/lib.sh passes it after a mirror fallback).
# =============================================================================
ARG VEDIT_QT6_BASE_IMAGE=docker.m.daocloud.io/library/ubuntu@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c
ARG BASE_IMAGE=docker.m.daocloud.io/library/centos@sha256:be65f488b7764ad3638f236b7b515b3678369a5124c47b8d32916d6487418ea4
FROM ${VEDIT_QT6_BASE_IMAGE} AS qt6-build

# The lock file is the build context's copy of scripts/docker/qt6-locked-packages.txt
# (the build context of this Dockerfile is scripts/docker/).
COPY qt6-locked-packages.txt /opt/vedit/qt6-locked-packages.txt

# Download the exact locked versions, verify every .deb sha256, then install
# them. A missing/renamed version fails here instead of drifting silently.
RUN set -eux; \
    apt-get update; \
    mkdir -p /tmp/qt6-debs; cd /tmp/qt6-debs; \
    while read -r spec sha rest; do \
      case "$spec" in ''|'#'*) continue;; esac; \
      apt-get download "$spec"; \
      deb=$(ls "${spec%%=*}"_*.deb); \
      printf '%s  %s\n' "$sha" "$deb" | sha256sum -c -; \
    done < /opt/vedit/qt6-locked-packages.txt; \
    cd /; rm -rf /tmp/qt6-debs; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential pkg-config git curl ca-certificates binutils file \
      xvfb xauth fonts-dejavu-core libgl1-mesa-dri mesa-utils \
      libxcb-cursor0 libxkbcommon-x11-0 libxcb-icccm4 libxcb-image0 \
      libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 \
      libxcb-xkb1 libxkbcommon0 \
      $(awk '!/^#/ && NF {print $1}' /opt/vedit/qt6-locked-packages.txt); \
    rm -rf /var/lib/apt/lists/*

# Assert the installed versions equal the lock again (defence in depth: the
# download check proves the archive, this proves the image), then record the
# facts the lane's evidence and the CMake guards rely on.
RUN set -eux; \
    while read -r spec sha rest; do \
      case "$spec" in ''|'#'*) continue;; esac; \
      pkg="${spec%%=*}"; ver="${spec#*=}"; \
      got=$(dpkg-query -W -f='${Version}' "$pkg"); \
      [ "$got" = "$ver" ] || { echo "FATAL: $pkg installed=$got locked=$ver" >&2; exit 1; }; \
    done < /opt/vedit/qt6-locked-packages.txt; \
    { echo "## image facts"; head -3 /etc/os-release; \
      echo "glibc: $(dpkg-query -W -f='${Version}' libc6)"; \
      strings /lib/x86_64-linux-gnu/libc.so.6 | grep -m1 'Minimum supported kernel'; \
      echo "qt6-base-dev: $(dpkg-query -W -f='${Version}' qt6-base-dev)"; \
      echo "kf6-texteditor: $(dpkg-query -W -f='${Version}' libkf6texteditor-dev)"; \
      echo "kf6-syntaxhighlighting: $(dpkg-query -W -f='${Version}' libkf6syntaxhighlighting-dev)"; \
      echo "tree-sitter: $(pkg-config --modversion tree-sitter)"; \
      echo "cmake: $(cmake --version | head -1)"; \
      echo "g++: $(g++ --version | head -1)"; \
    } | tee /opt/vedit/build-image.txt; \
    dpkg-query -W -f='${Package} ${Version} ${Architecture}\n' | sort > /opt/vedit/package-snapshot.txt

# UTF-8 locale + a writable runtime dir for the offscreen/xcb smoke runs; the
# compile step itself never depends on the host environment.
ENV LANG=C.UTF-8 \
    XDG_RUNTIME_DIR=/tmp/xdg-runtime

# =============================================================================
# Stage: rust-build — CentOS 7.9.2009 (glibc 2.17), the Rust/GTK deployment
# target itself, so that product's ELF never needs a newer glibc.
#
# Reproducibility (AC-19): the base image is pinned by digest, every download is
# pinned by sha256 in scripts/versions.env and verified before use, and the
# full installed RPM set is snapshotted (scripts/docker/rpm-baseline.txt) and
# compared on every build by scripts/build-in-container.sh.
# The CentOS base is a build argument so a transient mirror outage can be served
# by the Docker Hub fallback with the SAME digest (scripts/lib.sh resolves it);
# its ARG is declared once, in the global scope at the top of this file (a FROM
# can only read global-scope ARGs), so a normal build is identical to before.
# =============================================================================
FROM ${BASE_IMAGE} AS rust-build

ARG CENTOS_VAULT_BASE
ARG RUSTUP_URL
ARG RUSTUP_SHA256
ARG RUST_TOOLCHAIN
ARG GSV_URL
ARG GSV_SHA256
ARG MESON_WHEEL_URL
ARG MESON_WHEEL_SHA256
ARG NINJA_WHEEL_URL
ARG NINJA_WHEEL_SHA256

# The stock CentOS-*.repo files point at dead mirrors; use the vault snapshot
# (recipe: .mpd/recon/build-recipe-centos7.md). The repo file lives in the build
# context and is rendered with the pinned CENTOS_VAULT_BASE argument, so the
# image builds under BuildKit (no legacy-builder-only syntax).
COPY vault.repo.in /tmp/vault.repo.in
RUN rm -f /etc/yum.repos.d/CentOS-*.repo \
 && sed "s|@CENTOS_VAULT_BASE@|${CENTOS_VAULT_BASE}|g" /tmp/vault.repo.in > /etc/yum.repos.d/vault.repo \
 && rm -f /tmp/vault.repo.in \
 && cat /etc/yum.repos.d/vault.repo

# GTK3 + GtkSourceView build/runtime dependencies, an X server for the window
# smoke test, and the fonts a GTK application needs to lay out text.
RUN yum -y install \
      gcc gcc-c++ make pkgconfig git curl tar xz bzip2 which findutils file \
      glib2-devel gtk3-devel libxml2-devel gettext \
      gdk-pixbuf2 gdk-pixbuf2-devel \
      python3 \
      dejavu-sans-fonts dejavu-sans-mono-fonts fontconfig \
      xorg-x11-server-Xvfb xorg-x11-utils mesa-demos mesa-libGL \
 && yum clean all

# AC-16 (Chinese input) needs GTK input-method modules at runtime. The packaging
# lanes bundle them, so this step records which immodule packages the vault
# actually carries (and which .so files exist) instead of guessing later.
RUN mkdir -p /opt/vedit \
 && { echo "## gtk3 immodule packages in the CentOS 7.9.2009 vault:"; \
      for pkg in gtk3-immodule-xim gtk3-immodule-ibus ibus-gtk3; do \
        if yum -y install "$pkg" >/dev/null 2>&1; then echo "installed $pkg"; \
        else echo "not available: $pkg"; fi; \
      done; \
      echo "## immodule files:"; \
      ls -l /usr/lib64/gtk-3.0/3.0.0/immodules/ 2>&1 || true; \
    } | tee /opt/vedit/immodules.txt

# meson/ninja from sha256-pinned PyPI wheels (no pip, no unpinned index access).
RUN set -eux; \
    curl -fsSL -o /tmp/meson.whl "$MESON_WHEEL_URL"; \
    echo "$MESON_WHEEL_SHA256  /tmp/meson.whl" | sha256sum -c -; \
    curl -fsSL -o /tmp/ninja.whl "$NINJA_WHEEL_URL"; \
    echo "$NINJA_WHEEL_SHA256  /tmp/ninja.whl" | sha256sum -c -; \
    mkdir -p /opt/wheels/meson /opt/wheels/ninja; \
    python3 -m zipfile -e /tmp/meson.whl /opt/wheels/meson; \
    pysite=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])'); \
    mkdir -p "$pysite"; \
    cp -a /opt/wheels/meson/mesonbuild "$pysite/"; \
    { echo '#!/usr/bin/python3'; \
      echo 'import sys'; \
      echo 'from mesonbuild.mesonmain import main'; \
      echo 'if __name__ == "__main__":'; \
      echo '    sys.exit(main())'; \
    } > /usr/local/bin/meson; \
    chmod 755 /usr/local/bin/meson; \
    python3 -m zipfile -e /tmp/ninja.whl /opt/wheels/ninja; \
    cp /opt/wheels/ninja/ninja/data/bin/ninja /usr/local/bin/ninja; \
    chmod 755 /usr/local/bin/ninja; \
    meson --version; ninja --version

# Rust toolchain, installed inside the target distro so the ELF floor is
# CentOS 7's glibc. rustup-init and the toolchain version are pinned.
RUN set -eux; \
    curl -fsSL -o /tmp/rustup-init "$RUSTUP_URL"; \
    echo "$RUSTUP_SHA256  /tmp/rustup-init" | sha256sum -c -; \
    chmod 755 /tmp/rustup-init; \
    RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo /tmp/rustup-init \
      -y --no-modify-path --profile minimal --default-toolchain "$RUST_TOOLCHAIN"; \
    RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo /opt/cargo/bin/rustup component add \
      --toolchain "$RUST_TOOLCHAIN" rustfmt clippy; \
    chmod -R a+rX /opt/rust /opt/cargo; \
    RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo /opt/cargo/bin/rustc --version

# GtkSourceView 4.6.1 from the pinned upstream tarball (LGPL-2.1-or-later), into
# /opt/gsv4 so it never collides with a distribution gsv3.
RUN set -eux; \
    curl -fsSL -o /tmp/gtksourceview.tar.xz "$GSV_URL"; \
    echo "$GSV_SHA256  /tmp/gtksourceview.tar.xz" | sha256sum -c -; \
    mkdir -p /opt/src/gtksourceview; \
    tar -xJf /tmp/gtksourceview.tar.xz -C /opt/src/gtksourceview --strip-components=1; \
    cd /opt/src/gtksourceview; \
    meson setup build --prefix=/opt/gsv4 --libdir=lib64 \
      -Dgtk_doc=false -Dgir=false -Dvapi=false -Dinstall_tests=false -Dglade_catalog=false; \
    ninja -C build; \
    ninja -C build install; \
    rm -rf /opt/src/gtksourceview /tmp/gtksourceview.tar.xz

ENV PKG_CONFIG_PATH=/opt/gsv4/lib64/pkgconfig:/opt/gsv4/lib/pkgconfig \
    LD_LIBRARY_PATH=/opt/gsv4/lib64:/opt/gsv4/lib \
    RUSTUP_HOME=/opt/rust \
    RUSTUP_TOOLCHAIN=${RUST_TOOLCHAIN} \
    PATH=/opt/cargo/bin:/usr/local/bin:/usr/bin:/bin

# Record the exact installed package set inside the image (also committed as
# scripts/docker/rpm-baseline.txt and diffed on every build).
RUN { echo "## image facts"; cat /etc/centos-release; \
      echo "glibc: $(rpm -q glibc)"; \
      echo "gtk3: $(rpm -q gtk3)"; \
      echo "rust: $(/opt/cargo/bin/rustc --version)"; \
      echo "gsv4: $(PKG_CONFIG_PATH=/opt/gsv4/lib64/pkgconfig pkg-config --modversion gtksourceview-4)"; \
    } > /opt/vedit/build-image.txt \
 && rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /opt/vedit/rpm-snapshot.txt
