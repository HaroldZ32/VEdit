# Pinned inputs for the SELF-BUILT KSyntaxHighlighting (task T60, plan B′).
#
# WHY A SELF-BUILD
# The distro library (`libkf6syntaxhighlighting6 6.24.0-0ubuntu1`) embeds the
# syntax definitions as Qt resources: 450 `*.xml` resources, 387 parseable
# definitions, 36 of them strict-GPL (SystemVerilog = GPLv3+). A file-level
# "do not ship the XML" policy therefore does NOT describe what is distributed.
# `QRC_SYNTAX=OFF` (an upstream option, no source patch) stops the embedding and
# installs the definitions as files instead, so what we distribute is decided by
# OUR build configuration and OUR whitelist instead of the distro default.
# Evidence: evidence/r2-ksh-embedded/report.md, evidence/m0-ksh-selfbuild/.
#
# UPSTREAM PROVENANCE
# The build input is the official KDE Frameworks 6.24 release tarball, pinned by
# sha256; it corresponds to tag v6.24.0 whose commit the R2 lane verified
# (T56). The tarball is downloaded by the build and verified before extraction.
KSH_VERSION="6.24.0"
KSH_TAG="v6.24.0"
KSH_COMMIT="bbea2326fbd4fc720518efc43f1b018f8a7d0670"
KSH_TARBALL_URL="https://download.kde.org/stable/frameworks/6.24/syntax-highlighting-6.24.0.tar.xz"
KSH_TARBALL_SHA256="061c5946dc6170ecfa91b9c7d4faa5ec81eb53bb5f86eda861c2ce748a65486d"

# The options that make the library clean. Both are upstream options declared in
# the top-level CMakeLists.txt (QRC_SYNTAX:66, NO_STANDARD_PATHS:72); no source
# file is patched.
KSH_QRC_SYNTAX="OFF"          # definitions are NOT compiled into the library
#
# T61 selects HOW the whitelist reaches KTextEditor:
#   F1 = NO_STANDARD_PATHS=ON   (host paths never consulted; injection needs a
#                                const_cast because Editor::repository() is const)
#   F2 = NO_STANDARD_PATHS=OFF  (+ XDG_DATA_DIRS/XDG_DATA_HOME isolation; no
#                                const_cast, KTextEditor loads the whitelist itself)
# The decision and its measurements live in
# evidence/m0-ksh-selfbuild/FORM-DECISION.md. `bash scripts/build-ksh-selfbuild.sh
# --form F1|F2` can build either form for comparison.
# DECIDED by T61 (evidence/m0-ksh-selfbuild/FORM-DECISION.md): F2. The reason is
# that KTextEditor 6.24 has no public injection API and F1 would require a
# const_cast on "read-only access"; F2's host isolation was measured to hold
# when AppRun sets BOTH XDG_DATA_DIRS and XDG_DATA_HOME to AppDir (see the
# decision's C1-C8 conditions). F1 remains buildable with `--form F1` for
# comparison and its evidence is kept in build-logs-form-f1/.
KSH_FORM="F2"
KSH_NO_STANDARD_PATHS="OFF"   # must agree with KSH_FORM (F1=ON, F2=OFF)
# Keep the build small and deterministic; the GUI parts are still needed because
# KTextEditor uses KSyntaxHighlighting's GUI integration.
KSH_BUILD_TESTING="OFF"
KSH_USE_GUI="ON"

# Build tree, install tree and evidence (all inside the workspace; target/ is
# gitignored, evidence/ is committed).
KSH_BUILD_ROOT="target/ksh-selfbuild"
KSH_EVIDENCE_DIR="evidence/m0-ksh-selfbuild"
# The M0 Qt6 build image (scripts/versions-qt.env) is reused as the toolchain;
# this lane adds NO second image and NO second Qt.

# Expectations the build asserts, so "clean" is attributable to the options and
# not to luck:
KSH_EXPECTED_EMBEDDED_DEFINITIONS="0"
# `data/themes/theme-data.qrc` is added to the library UNCONDITIONALLY upstream
# (`data/CMakeLists.txt:107`); QRC_SYNTAX does not control it and there is no
# QRC_THEMES switch, so the 30 .theme resources remain embedded (U11). T60 does
# not fork data/CMakeLists.txt; it reports this fact for T16/T11 to decide.
KSH_EXPECTED_EMBEDDED_THEMES="30"
