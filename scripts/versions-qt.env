# Pinned build inputs for the VEdit Qt6/KF6 C++ lane (M0 build base, task T10).
#
# This file is the single source of truth for the C++ lane. It is consumed by
#   * scripts/lib-qt.sh / scripts/build-qt.sh (image + container commands),
#   * cmake/VEditVersions.cmake (the same numbers become CMake `EXACT` requests),
#   * scripts/docker/Dockerfile.build (stage `qt6-build`, via the build args the
#     script passes; the .deb hashes live in scripts/docker/qt6-locked-packages.txt).
#
# WHY A MODERN BUILD DISTRO AND NOT CENTOS 7
# ------------------------------------------
# The deliverable carries its own ld-linux + glibc + Qt6/KF6 runtime (C2, task
# T11), so the C++ binary may legitimately require symbols newer than CentOS 7's
# glibc 2.17 -- the private loader supplies them. Building ON CentOS 7 would buy
# nothing and would be impossible: KF6 6.24 requires Qt >= 6.8 upstream
# (`set(REQUIRED_QT_VERSION 6.8.0)` in KDE/ktexteditor v6.24.0 CMakeLists.txt),
# and no Qt >= 6.5 exists in the CentOS 7 vault at all. The last stage of
# scripts/docker/Dockerfile.build remains the historical CentOS 7 Rust/GTK image,
# so existing scripts that build that Dockerfile without --target are unchanged.
#
# KERNEL COMPATIBILITY WITH CENTOS 7.9 (kernel 3.10)
# --------------------------------------------------
# The bundled glibc is the build distro's own. Ubuntu 26.04's glibc 2.43 is
# compiled with a minimum supported kernel of 3.2.0 -- value embedded in
# /lib/x86_64-linux-gnu/libc.so.6 ("Minimum supported kernel: 3.2.0") and in its
# .note.ABI-tag (ABI: 3.2.0) -- so it runs on the CentOS 7.9 (3.10) kernel.
# Evidence: evidence/m0-build/02-glibc-loader-probe-raw.txt, 04-abi-tag-probe.txt.
# The ELF baseline is plain x86-64 ("x86 ISA needed: x86-64-baseline" in
# libc.so.6), not x86-64-v3. Evidence: evidence/m0-build/03-elf-isa-notes.txt.
# NOTE: the containers used on this host share the host kernel, so "kernel 3.10"
# is proven by the glibc build guarantee above, not by an observed boot on a
# 3.10 kernel; the real hard-gate run is T12's host matrix.

# Build distro image, pinned by digest (Ubuntu 26.04.1 LTS).
VEDIT_QT6_BASE_IMAGE="docker.m.daocloud.io/library/ubuntu"
VEDIT_QT6_BASE_IMAGE_DIGEST="sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c"
VEDIT_QT6_DISTRO="Ubuntu 26.04.1 LTS"
VEDIT_QT6_DISTRO_GLIBC="2.43-2ubuntu2.4"

# --- Version matrix (every entry is asserted EXACT, never a range) -----------
# Qt6: Ubuntu 26.04 qt6-base-dev 6.10.2+dfsg-7. Product floor is Qt 6.5 (C5:
# KF6 6.0 requires Qt 6.5); this matrix is far above it.
VEDIT_QT6_VERSION="6.10.2"
VEDIT_QT6_MIN_VERSION="6.5"
# KF6 / KTextEditor / KSyntaxHighlighting: 6.24.0-0ubuntu1 (one KF6 release).
VEDIT_KF6_VERSION="6.24.0"
VEDIT_KF6_MIN_VERSION="6.5"
# KF6 6.24.0 itself requires Qt >= 6.8.0 (upstream KDE/ktexteditor v6.24.0,
# KDE/syntax-highlighting v6.24.0: `set(REQUIRED_QT_VERSION 6.8.0)`); recorded so
# the floor relationship is auditable as data, not as prose only.
VEDIT_KF6_REQUIRED_QT_VERSION="6.8.0"
VEDIT_KTEXTEDITOR_VERSION="6.24.0"
VEDIT_KSYNTAXHIGHLIGHTING_VERSION="6.24.0"
# tree-sitter runtime + headers: Ubuntu 26.04 libtree-sitter-dev 0.25.9-7
# (pkg-config `tree-sitter` reports 0.25.9; CMake requests it EXACT).
VEDIT_TREE_SITTER_VERSION="0.25.9"
# Toolchain the image installs (asserted at image build time).
VEDIT_QT6_CMAKE_VERSION="4.2.3"
VEDIT_QT6_NINJA_VERSION="1.13.2"
VEDIT_QT6_GXX_VERSION="15.2.0"

# --- Runtime facts that the packaging lane (T11) must conserve ---------------
# AppImage type-2 needs libfuse2 on the host (C3/A7, registered prerequisite).
VEDIT_HOST_FUSE_PACKAGE="libfuse2t64 (libfuse2 ABI)"
VEDIT_HOST_FUSE_VERSION="2.9.9-9build1"
# Loader reported by the build distro; T11 bundles it and the matching libc.
VEDIT_QT6_BUNDLED_LOADER="ld-linux-x86-64.so.2"
VEDIT_QT6_MIN_KERNEL="3.2.0"
