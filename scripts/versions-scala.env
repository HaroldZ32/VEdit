# Pinned inputs for the OFFLINE Scala toolchain bundled in the AppDir (T12 /
# AC-7.1, 7.2, 7.4, 7.11 packaging half).
#
# Every value is an INPUT of packaging/runtime/build-scala-payload.sh; the build
# fails loudly when a downloaded artifact does not match its sha256 (the JDK and
# sbt hashes are the ones upstream publishes beside the artifact). Nothing here
# is fetched at runtime: the AppDir carries the whole payload.
#
# Component choices and why:
#   * JDK        — Eclipse Temurin 21 (GPLv2 + Classpath Exception). The Linux
#                  x64 build targets glibc 2.17+, i.e. CentOS 7 runs it natively;
#                  the AppDir wrapper still pins JAVA_HOME and the cache homes.
#   * scala-cli  — the STATIC native image (`x86_64-pc-linux-static`), so it
#                  carries no glibc requirement at all and starts without a JVM.
#   * sbt        — the 1.x line (1.13.1). sbt 2.x changes the build dialect; the
#                  product's one-click lane and the prewarmed caches are 1.x.
#                  The launcher scripts plus `lib/` are shipped; boot/ivy/coursier
#                  caches are PREWARMED at build time into the payload.
#   * coursier   — `cs` static binary; it is the Metals launcher AND the offline
#                  resolver whose cache the payload ships.
#   * Metals     — `org.scalameta:metals_2.13:1.6.9` (the server), with mtags for
#                  the two Scala versions the lane supports. mtags is published
#                  PER Scala version: 2.13.12 stops at 1.5.1, 2.13.18 starts at
#                  1.6.3 — both are pinned below, exactly as Metals resolves them.
#   * Bloop      — `ch.epfl.scala:bloop-frontend_2.12:1.5.18`, the build server
#                  Metals 1.6.x drives.

SCALA_JDK_VERSION="21.0.13_9"
SCALA_JDK_URL="https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13%2B9/OpenJDK21U-jdk_x64_linux_hotspot_21.0.13_9.tar.gz"
SCALA_JDK_SHA256="d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c"

SCALA_CLI_VERSION="1.18.0"
SCALA_CLI_URL="https://github.com/VirtusLab/scala-cli/releases/download/v1.18.0/scala-cli-x86_64-pc-linux-static.gz"
SCALA_CLI_SHA256="8a800ea7064e72ceaa8a2cf16007522e266a8073796a8d624081fb5e418545b3"

SBT_VERSION="1.13.1"
SBT_URL="https://github.com/sbt/sbt/releases/download/v1.13.1/sbt-1.13.1.tgz"
SBT_SHA256="4a20e36c1642b6d5be34ef641d2ed6c8c0d464e6145283730d5566716e4083be"

CS_VERSION="2.1.26"
CS_URL="https://github.com/coursier/coursier/releases/download/v2.1.26/cs-x86_64-pc-linux-static.gz"
CS_SHA256="21021ff6689637bd0fce276c91171aabe67c70c72a3c805e6daddbc9ca58f6c4"

METALS_VERSION="1.6.9"
BLOOP_VERSION="1.5.18"
# The Scala versions the one-click lane and the prewarmed caches cover.
SCALA_MAIN_VERSION="2.13.18"
SCALA_LEGACY_VERSION="2.13.12"
MTAGS_MAIN_VERSION="1.6.9"    # published for 2.13.18
MTAGS_LEGACY_VERSION="1.5.1"  # the last mtags published for 2.13.12

# Artifacts resolved (and cached) at BUILD time. The cache dir ships, so the
# runtime never resolves anything.
METALS_COORD="org.scalameta:metals_2.13:${METALS_VERSION}"
BLOOP_COORD="ch.epfl.scala:bloop-frontend_2.12:${BLOOP_VERSION}"
MTAGS_MAIN_COORD="org.scalameta:mtags_2.13.18:${MTAGS_MAIN_VERSION}"
MTAGS_LEGACY_COORD="org.scalameta:mtags_2.13.12:${MTAGS_LEGACY_VERSION}"

# --- the two PREWARMED example toolchains (T18 / AC-7.6, AC-7.3, AC-7.7) ----
# Two hardware-construction stacks, pinned at the versions the product promises
# to run offline. They are prewarmed into SEPARATE home trees on purpose:
# SpinalHDL is the 2.13.12-era line, Chisel 7.x rides 2.13.18 and needs the
# firtool native backend. One shared cache would let either stack satisfy the
# other's resolution — exactly the contamination the requirement forbids.
SPINALHDL_VERSION="1.15.1"
SPINALHDL_SCALA_VERSION="2.13.12"
SPINALHDL_CORE_COORD="com.github.spinalhdl:spinalhdl-core_2.13:${SPINALHDL_VERSION}"
SPINALHDL_LIB_COORD="com.github.spinalhdl:spinalhdl-lib_2.13:${SPINALHDL_VERSION}"

CHISEL_VERSION="7.16.0"
CHISEL_SCALA_VERSION="2.13.18"
CHISEL_COORD="org.chipsalliance:chisel_2.13:${CHISEL_VERSION}"
# The compiler plugin is a SEPARATE artifact whose cross version is the FULL
# Scala version (chisel-plugin_2.13.18); chisel 7 refuses to compile without it.
CHISEL_PLUGIN_COORD="org.chipsalliance:chisel-plugin_2.13.18:${CHISEL_VERSION}"
# firtool-resolver version chisel_2.13 7.16.0 depends on (from its pom); pinned
# so the native firtool the cache carries is the one the library asks for.
FIRTOOL_RESOLVER_VERSION="2.1.1"
FIRTOOL_RESOLVER_COORD="org.chipsalliance:firtool-resolver_2.13:${FIRTOOL_RESOLVER_VERSION}"
