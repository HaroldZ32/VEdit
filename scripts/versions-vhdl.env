# Pinned inputs for the OFFLINE VHDL toolchain bundled in the AppDir (T11).
#
# Every value is an INPUT of packaging/runtime/build-vhdl-payload.sh; the build
# fails loudly when a downloaded artifact does not match its sha256. Nothing here
# is fetched at runtime: the AppDir carries the whole payload, and the probe in
# evidence/batch-20261110/vhdl-pack/ proves the children start with no network.
#
# Component choices and why:
#   * vhdl_ls  — upstream ships a STATIC musl build (`static-pie linked`), so it
#                carries no glibc requirement at all.
#   * GHDL     — the mcode variant (no LLVM). The upstream Linux binaries are
#                built on ubuntu24.04 (GLIBC 2.39); the AppDir ships its OWN
#                glibc 2.43 + loader, and the bin/ghdl wrapper starts it through
#                that loader, verified with --version.
#   * CPython  — built from source inside the pinned Qt6 image (the same glibc
#                the AppDir ships), so the child runs through the bundled loader.
#   * VSG      — pure-Python wheel (`py3-none-any`) installed into the bundled
#                CPython at BUILD time; its only runtime dependency is PyYAML.

VHDL_LS_VERSION="0.88.0"
VHDL_LS_URL="https://github.com/VHDL-LS/rust_hdl/releases/download/v0.88.0/vhdl_ls-x86_64-unknown-linux-musl.zip"
VHDL_LS_SHA256="5cb90333e5f93e11d83d4f980b7c7ff204b11283c854efcafe2ff0b5cf41f7ec"

GHDL_VERSION="6.0.0"
GHDL_URL="https://github.com/ghdl/ghdl/releases/download/v6.0.0/ghdl-mcode-6.0.0-ubuntu24.04-x86_64.tar.gz"
GHDL_SHA256="30d6a977b8456d140bbafecbbe64b1947a3d92eeae8f5e6d9f528a174f9566e7"

VHDL_PYTHON_VERSION="3.12.8"
VHDL_PYTHON_URL="https://www.python.org/ftp/python/3.12.8/Python-3.12.8.tgz"
VHDL_PYTHON_SHA256="5978435c479a376648cb02854df3b892ace9ed7d32b1fead652712bee9d03a45"

VSG_VERSION="3.36.0"
VSG_WHEEL_URL="https://files.pythonhosted.org/packages/a6/52/e5162a756b13d340d58d8eb295af93b916666e0291735a4115c791112daa/vsg-3.36.0-py3-none-any.whl"
VSG_WHEEL_SHA256="0bd937ee96b19b35e14c5e864ecd2702ea9c6dbdbc6be1f58819bc8d24151019"

PYYAML_VERSION="6.0.3"
