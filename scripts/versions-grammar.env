# Pinned inputs for tree-sitter GRAMMAR GENERATION (task T60; lane T17).
#
# Two different tree-sitter things are pinned, in two different files, and they
# are deliberately NOT merged:
#
#   * the RUNTIME library `libtree-sitter` (0.25.9) is part of the M0 runtime and
#     is pinned in scripts/versions-qt.env + scripts/docker/qt6-locked-packages.txt
#     (it ships inside the private runtime, C18);
#   * the CLI used to (re)generate the committed parser C sources is THIS file.
#     The generated `parser.c` / `scanner.c` are build artefacts of the CLI
#     version, so "the grammars can be regenerated" is only reproducible when the
#     CLI is pinned too (T17 review finding N5).
#
# This file does not change the M0 runtime and must not be added to it.
TREE_SITTER_CLI_VERSION="0.27.1"

# 1) The npm package that provides the `tree-sitter` launcher (small, JS only:
#    it downloads the platform binary from the GitHub release below).
TREE_SITTER_CLI_NPM_URL="https://registry.npmjs.org/tree-sitter-cli/-/tree-sitter-cli-0.27.1.tgz"
TREE_SITTER_CLI_NPM_SHA256="4ece7204684483f281b5e10097caefc92afbd6362a948a12e755d711da9b15ba"

# 2) The platform binary actually executed (linux-x64): what regenerates the
#    parsers and what must therefore be hashed.
TREE_SITTER_CLI_BIN_URL="https://github.com/tree-sitter/tree-sitter/releases/download/v0.27.1/tree-sitter-cli-linux-x64.zip"
TREE_SITTER_CLI_BIN_SHA256="c7e686aec16ba17053c2e6fd87600ccb10cf8ba3d055756b17e756d538e11114"
TREE_SITTER_CLI_BIN_SIZE="8642525"

# The expected `tree-sitter --version` string, asserted by
# scripts/check-tree-sitter-cli.sh (run it inside the pinned M0 image so the
# assertion uses the same glibc/toolchain as the build).
TREE_SITTER_CLI_VERSION_OUTPUT="tree-sitter 0.27.1"
