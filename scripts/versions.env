# Pinned build inputs for VEdit — ONE source of truth (AC-19).
#
# Every download named here is verified by sha256 before use (the Dockerfile and
# the build scripts fail hard on a mismatch). `CENTOS_VAULT_BASE` is the
# snapshot mirror verified in .mpd/recon/build-recipe-centos7.md. The packaging
# lanes (T23/T25) extend this file, never a second one.
#
# Base image: CentOS 7.9.2009 x86_64 (glibc 2.17), pinned by digest so a mutable
# tag can never change the build underneath us.
VEDIT_BASE_IMAGE="docker.m.daocloud.io/library/centos"
VEDIT_BASE_IMAGE_DIGEST="sha256:be65f488b7764ad3638f236b7b515b3678369a5124c47b8d32916d6487418ea4"
CENTOS_VAULT_BASE="https://mirrors.tuna.tsinghua.edu.cn/centos-vault/7.9.2009"

# Rust toolchain. Pinned in rust-toolchain.toml too; the image installs exactly
# this version so host and container gates run the same rustc/clippy.
RUST_TOOLCHAIN="1.99.0"
RUSTUP_VERSION="1.29.2"
RUSTUP_URL="https://static.rust-lang.org/rustup/archive/1.29.2/x86_64-unknown-linux-gnu/rustup-init"
RUSTUP_SHA256="5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4"

# GtkSourceView 4.6.1: the newest gsv4 line whose meson accepts CentOS 7's
# GTK 3.22.30 (4.8 requires gtk+-3.0 >= 3.24). Its Verilog/SystemVerilog
# language files are byte-identical to 4.8.4 (T5 evidence/language-spec-equality.txt).
GSV_VERSION="4.6.1"
GSV_URL="https://download.gnome.org/sources/gtksourceview/4.6/gtksourceview-4.6.1.tar.xz"
GSV_SHA256="63f487a7ab59612ffa9e7be1883dbd274ab1016afcede3239b93b0fc384df874"

# meson 0.59.4 / ninja 1.11.1, installed from sha256-pinned PyPI wheels (no pip,
# no unpinned index access). meson 0.59 is the version T5 verified on CentOS 7.
MESON_VERSION="0.59.4"
MESON_WHEEL_URL="https://files.pythonhosted.org/packages/01/48/b4ba2490ed26c73618736dece01a68a609713f1a7923563d4c41ac966b3b/meson-0.59.4-py3-none-any.whl"
MESON_WHEEL_SHA256="9db5bb89d3bd1c8e9c15974be5fa656f50491c48d53c43b6eb5cfe406dff3fd6"
NINJA_VERSION="1.11.1"
NINJA_WHEEL_URL="https://files.pythonhosted.org/packages/0f/58/854ce5aab0ff5c33d66e1341b0be42f0330797335011880f7fbd88449996/ninja-1.11.1-py2.py3-none-manylinux_2_12_x86_64.manylinux2010_x86_64.whl"
NINJA_WHEEL_SHA256="817e2aee2a4d28a708a67bcfba1817ae502c32c6d8ef80e50d63b0f23adf3a08"

# Packaging lane input (T23/T25): appimagetool, pinned to the sha256 T5 measured
# for the continuous-build release it used.
APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
APPIMAGETOOL_SHA256="793fca0ce4bcc309dc65d3f66669f58e3755643e4dadbe03932e7b436128494f"

# External artifact consumed (not rebuilt) by this project: the slang binary
# built by T3 (build/slang/out/slang). Recorded here so packaging lanes know the
# expected sha256 of the artifact they must bundle.
SLANG_BIN_SHA256="63cb60a05f6ca57f648b8e2ef6de61ee0a3132c1c9d481f831dba52388832252"

# Verible suite (AC-01 / AC-07): the three bundled binaries, pinned by download
# URL + sha256 (the URL is the only pinned source; the copy under
# .mpd/recon/verible/bin/ is harness state and is gitignored). Packaging lanes
# (T23/T25) MUST fetch from this URL and verify the three sha256 values; copying
# the recon directory is not acceptable because it cannot be rebuilt from the
# repository. Re-verified against the release tarball on 2026-10-30.
VERIBLE_VERSION="v0.0-4298-g085eef05"
VERIBLE_URL="https://github.com/chipsalliance/verible/releases/download/v0.0-4298-g085eef05/verible-v0.0-4298-g085eef05-linux-static-x86_64.tar.gz"
VERIBLE_TARBALL_SHA256="ca83778c7c2b73272277bd670d1851c8caf973fd3283688aeb0d36d4b3598a90"
VERIBLE_LS_SHA256="07bf6b456dae27815cc1d6f9952beb232a5d4b3242c5e11a417028b64e67b845"
VERIBLE_LINT_SHA256="b9d56f9a180c33fb57f601174586c81348422ca28e27632074106c130d673b29"
VERIBLE_FORMAT_SHA256="b0a7b1ae948ca82e9d73a8a93e3844e4b2daa1db59df1f1eb5e1050260828473"

# Shared release remap (all products must consume the same vd-app binary):
# source roots become /vedit, cargo homes become /cargo, so the ELF does not
# depend on where the tree was built. Longest prefixes first.
RELEASE_RUSTFLAGS="--remap-path-prefix=/vedit-build/target/cargo-home=/cargo --remap-path-prefix=/root/.cargo=/cargo --remap-path-prefix=/opt/cargo=/cargo --remap-path-prefix=/opt/rust=/rust --remap-path-prefix=/vedit-build=/vedit"

# Noto Sans CJK (T119): vendored TTC, OFL-1.1; source package fonts-noto-cjk
# 1:20240730+repack1-1build1 (Ubuntu), upstream github.com/notofonts/noto-cjk.
NOTO_CJK_FONT_SHA256="b76b0433203017ca80401b2ee0dd69350349871c4b19d504c34dbdd80541690a"
NOTO_CJK_FONT_SIZE="19484784"

# --- VCS toolchain: git + subversion bundled into the AppDir (rev3, T23) -----
# The product ships its own runtime, so it carries the VCS tools too: the host
# may have no git/svn, or an ancient one. The binaries are unpacked from these
# sha256-pinned Ubuntu .debs by packaging/runtime/assemble-appdir.sh into
# <AppDir>/usr/lib/vcs/ and started through the AppDir's own loader (the same
# mechanism the product uses), so the VCS stack never loads — and never
# shadows — the product's Qt/libssl/libsqlite3.
#
# The .deb payloads are the distribution's unmodified binaries (the Apache-2.0 /
# GPLv2 notices and the source-availability paths are in THIRD_PARTY_NOTICES.md
# §11). `svnadmin` is extracted to build/vcs-tools/ for E2E only and is NOT
# shipped (asserted by assemble-appdir.sh).
VCS_GIT_VERSION="2.53.0"
VCS_SVN_VERSION="1.14.5"
VCS_GIT_MIN_VERSION="2.43"
VCS_SVN_MIN_VERSION="1.14"
# pin order must match VCS_DEB_SHA256S one-to-one
VCS_DEB_URLS=(
  "http://archive.ubuntu.com/ubuntu/pool/main/g/git/git_2.53.0-1ubuntu1.1_amd64.deb"
  "http://archive.ubuntu.com/ubuntu/pool/universe/s/subversion/subversion_1.14.5-6build1_amd64.deb"
  "http://archive.ubuntu.com/ubuntu/pool/universe/s/subversion/libsvn1_1.14.5-6build1_amd64.deb"
  "http://archive.ubuntu.com/ubuntu/pool/main/a/apr/libapr1t64_1.7.6-3_amd64.deb"
  "http://archive.ubuntu.com/ubuntu/pool/main/a/apr-util/libaprutil1t64_1.6.3-3ubuntu3.1_amd64.deb"
  "http://archive.ubuntu.com/ubuntu/pool/universe/s/serf/libserf-1-1_1.3.10-3ubuntu2_amd64.deb"
  "http://archive.ubuntu.com/ubuntu/pool/universe/u/utf8proc/libutf8proc3_2.10.0-2_amd64.deb"
)
VCS_DEB_SHA256S=(
  "5d3bbbb8e5bee7ddeb1d023b9a9d2063633e30c3ec404fd1d75136d9c6e48603"
  "e5efc3e6f38d43a2d5f2f198c1c54d520683d0986d6eb6c8a7d3f1bde8d53a7f"
  "0e6f54bd82ba80244905b714ef42614cf53be02232d754f5d22f9a83e2a18b7f"
  "7c1f4005fc41adfba1ce1a000a10fbf3a87f83c0c98525ab76a5483e9147192c"
  "6b4e3aab702b0a3b71767bdf93c7f625196170774ad5724c0e9314bea4cafaa8"
  "ff3fa687048f955bc67e8d31683a5664e4575530a3ed1783c6e68c8c3345e98b"
  "9d220df86d3c2dc6f847537358ffae17d99726d703404a13f5548e60f9ff0695"
)
